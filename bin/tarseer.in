#!@PYTHON@
"""Launcher installed as `tarseer`. Meson fills in the @...@ placeholders."""

import gettext
import locale
import os
import signal
import sys

VERSION = "@VERSION@"
APP_ID = "@APP_ID@"
pkgdatadir = "@pkgdatadir@"
localedir = "@localedir@"

sys.path.insert(1, pkgdatadir)
signal.signal(signal.SIGINT, signal.SIG_DFL)
try:
    locale.setlocale(locale.LC_ALL, "")
except locale.Error:
    # The locale isn't in the runtime, so the C side (GtkBuilder) stays
    # untranslated. Keep Python's gettext, which reads LANGUAGE/LANG itself,
    # untranslated too, or the window comes out half translated.
    print("tarseer: locale {} not available, using English".format(
        os.environ.get("LC_ALL") or os.environ.get("LANG") or "?"), file=sys.stderr)
    os.environ["LANGUAGE"] = "C"
    try:
        locale.setlocale(locale.LC_ALL, "C.UTF-8")
    except locale.Error:
        pass
# C side (GtkBuilder, for the Blueprint UI files).
locale.bindtextdomain("tarseer", localedir)
locale.textdomain("tarseer")
# Python side: the default domain for core.i18n, and the builtins _() and
# ngettext() used by the UI modules.
gettext.bindtextdomain("tarseer", localedir)
gettext.textdomain("tarseer")
gettext.install("tarseer", localedir, names=["ngettext"])

if __name__ == "__main__":
    from gi.repository import Gio

    resource = Gio.Resource.load(os.path.join(pkgdatadir, "tarseer.gresource"))
    resource._register()

    from tarseer import main

    sys.exit(main.main(VERSION))
