  </screenshots>
  <developer id="io.github.davideb263">
    <name translate="no">Davide Botter</name>
  </developer>
  <url type="homepage">https://github.com/davideb263/Tarseer</url>
  <url type="bugtracker">https://github.com/davideb263/Tarseer/issues</url>
  <url type="vcs-browser">https://github.com/davideb263/Tarseer</url>
  <launchable type="desktop-id">io.github.davideb263.Tarseer.desktop</launchable>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="0.3.0" date="2026-11-24">
      <description translate="no">
        <p>Tarseer can now check for updates on its own and tell you when there are new versions.</p>
        <ul>
          <li>Optional background checks: at login only, or every 6 hours, 12 hours or once a day</li>
          <li>A notification lists the apps with new updates; clicking it opens Tarseer</li>
          <li>Repeated checks reuse GitHub's previous answer: with an access token, unchanged releases no longer count against the request limit</li>
          <li>After choosing another release file for an app that is up to date, it can be reinstalled right away</li>
          <li>Release files for riscv64gc, powerpc64, loongarch64 and MIPS are no longer offered on other machines</li>
        </ul>
      </description>
    </release>
    <release version="0.2.1" date="2026-11-24">
      <description translate="no">
        <p>Bug fixes and security hardening.</p>
        <ul>
          <li>Downloads are checked against the size and checksum GitHub publishes, and only HTTPS is used</li>
          <li>The GitHub access token is no longer sent when a request is redirected to another server</li>
          <li>Archives can no longer place links pointing outside the app folder or add entries to the menu file</li>
          <li>Installing stops before the disk would run almost full</li>
          <li>Rate limit and rejected token errors from a check are shown once, in a dialog</li>
          <li>Rows no longer stay marked as queued after Update All, and cancelling is no longer offered during extraction</li>
        </ul>
      </description>
    </release>
    <release version="0.2.0" date="2026-11-24">
      <description translate="no">
        <p>Updating many apps is now one click, and you stay in control of it.</p>
        <ul>
          <li>Update All updates every app with an available update, one after another</li>
          <li>Running downloads can be cancelled, and Update All can be stopped</li>
          <li>The release file can be picked again from an app's details</li>
          <li>Changing an app's repository asks for the file again when the new one names its files differently, instead of failing on the next update</li>
          <li>An optional GitHub access token in Preferences raises the limit from 60 to 5,000 requests per hour</li>
        </ul>
      </description>
    </release>
    <release version="0.1.0" date="2026-11-23"/>
  </releases>
</component>
