using Gtk 4.0;
using Adw 1;

template $TarseerWindow: Adw.ApplicationWindow {
  title: _("Tarseer");
  width-request: 360;
  height-request: 294;

  content: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      [start]
      Button {
        icon-name: "list-add-symbolic";
        tooltip-text: _("Add App");
        action-name: "win.add-app";
      }

      [start]
      Button {
        icon-name: "view-refresh-symbolic";
        tooltip-text: _("Check for Updates");
        action-name: "win.check-updates";
      }

      [end]
      MenuButton {
        primary: true;
        icon-name: "open-menu-symbolic";
        tooltip-text: _("Main Menu");
        menu-model: primary_menu;
      }

      [end]
      Button update_all_button {
        label: _("_Update All");
        use-underline: true;
        tooltip-text: _("Update every app with an available update, one after another");
        action-name: "win.update-all";
        visible: false;

        styles [
          "suggested-action",
        ]
      }
    }

    content: Adw.ToastOverlay toast_overlay {
      child: Stack main_stack {
        transition-type: crossfade;

        StackPage {
          name: "empty";
          child: Adw.StatusPage {
            icon-name: "package-x-generic-symbolic";
            title: _("No Apps Yet");
            description: _("Add a GitHub repository to install its tarball releases and keep them up to date");

            child: Button {
              label: _("_Add App");
              use-underline: true;
              halign: center;
              action-name: "win.add-app";

              styles [
                "pill",
                "suggested-action",
              ]
            };
          };
        }

        StackPage {
          name: "list";
          child: ScrolledWindow {
            hscrollbar-policy: never;

            child: Adw.Clamp {
              margin-top: 24;
              margin-bottom: 24;
              margin-start: 12;
              margin-end: 12;

              child: ListBox list_box {
                selection-mode: none;
                valign: start;
                row-activated => $on_row_activated();

                styles [
                  "boxed-list",
                ]
              };
            };
          };
        }

        StackPage {
          name: "error";
          child: Adw.StatusPage error_page {
            icon-name: "dialog-error-symbolic";
            title: _("Could Not Load Your Apps");
          };
        }
      };
    };
  };
}

menu primary_menu {
  section {
    item {
      label: _("_Preferences");
      action: "win.preferences";
    }

    item {
      label: _("_About Tarseer");
      action: "app.about";
    }
  }
}
